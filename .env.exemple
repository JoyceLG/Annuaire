# ============================ Environnement =============================
# developpement | test | production. Absent : developpement.
ENVIRONNEMENT=developpement
FLASK_APP="annuaire:creer_app"
# En production, ce fichier n'est pas lu : exporter les variables dans le
# shell, avec FLASK_SKIP_DOTENV=1 (voir DEPLOIEMENT.md).

# ============================ Obligatoire ===============================
# Sans elles, l'application refuse de démarrer (quel que soit l'environnement).
CLE_SECRETE_JWT=
# La base se choisit par cette seule URL : postgresql+psycopg://…, sqlite:///…
# Avec docker-compose (service base publié sur 127.0.0.1:5432) :
# URL_BASE_DE_DONNEES=postgresql+psycopg://annuaire:<mot de passe>@127.0.0.1:5432/annuaire
URL_BASE_DE_DONNEES=

# ============================ Docker et tests ===========================
# Mot de passe du Postgres de docker-compose.yaml, repris dans les URL.
MOT_DE_PASSE_BASE=
# Base vidée par chaque test : son nom doit se terminer par _tests, ou être
# une base SQLite en mémoire (sqlite://). Voir README, « Choisir la base ».
# URL_BASE_TESTS=postgresql+psycopg://annuaire:<mot de passe>@127.0.0.1:5432/annuaire_tests
URL_BASE_TESTS=

# ======================= Facultatif : tout le reste ======================
# Chaque ligne laissée vide ou absente garde la valeur par défaut de la classe
# de configuration. Liste complète dans annuaire/config.py.

# --- Authentification ---
# DUREE_JETON_MINUTES=30
# ALGORITHME_JWT=HS256
# À n'activer que derrière un reverse proxy qui réécrit X-Forwarded-For.
# FAIRE_CONFIANCE_PROXY=false

# --- Coût du hachage argon2 (à ajuster à la machine) ---
# ARGON2_TEMPS=3
# ARGON2_MEMOIRE=65536
# ARGON2_PARALLELISME=4

# --- Journalisation ---
# NIVEAU_LOG=INFO
# NIVEAU_LOG_WERKZEUG=WARNING     une ligne par requête HTTP dès INFO
# FORMAT_LOG=json                 json | texte
# FICHIER_LOG=                    vide : sortie standard ; sinon fichier tournant

# --- Base de données ---
# ECHO_SQL=false
# Pool de connexions, ignoré par les bases sans serveur (SQLite) :
# POOL_TAILLE=5
# POOL_DEBORDEMENT=10
# POOL_RECYCLAGE_SECONDES=1800
# POOL_TIMEOUT_SECONDES=30
